# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL connection string (required).
# Local embedded database (npm run db:start) uses postgres:postgres on port 5432.
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/expense_tracker?schema=public"

# Secret used to sign session tokens (required in production, at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Timezone used to decide "today" for period filters (This Week, This Month, ...).
# Optional, defaults to Asia/Jakarta.
APP_TIMEZONE="Asia/Jakarta"

# Base URL used by the integration tests (npm test). Optional, defaults to http://localhost:3000.
# BASE_URL="http://localhost:3000"
